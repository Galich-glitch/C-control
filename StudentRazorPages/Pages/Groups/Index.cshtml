@page
@model StudentRazorPages.Pages.GroupsModel

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h2 mb-0">Группы <small class="text-body-secondary fs-6">(@Model.TotalCount)</small></h1>
        <a asp-page="Create" class="btn btn-primary">Добавить</a>
    </div>

    @if (Model.Groups.Count == 0)
    {
        <div class="alert alert-info mb-0">Ничего не найдено.</div>
    }
    else
    {
        <form method="get" class="mb-3 d-flex gap-2">
            <input asp-for="SearchTerm" class="form-control" placeholder="Поиск по названию..." />
            <button type="submit" class="btn btn-outline-primary">Найти</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a asp-page="Groups" class="btn btn-outline-secondary">Сбросить</a>
            }
        </form>
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model.Groups)
                {
                    <partial name="_GroupRow" model="group" />
                }
            </tbody>
        </table>
    }
</div>